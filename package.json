{
  "name": "webrtc-voice-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:signaling": "node server/index.js",
    "dev:gemini": "cd gemini-server && ./venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:signaling\" \"npm run dev:gemini\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/simple-peer": "^9.11.9",
    "concurrently": "^10.0.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
